NODE_ENV=production
PORT=5000
MONGO_URI=

SUPER_ADMIN_EMAIL=
SUPER_ADMIN_PASSWORD=

# SSLCommerz Configuration (Sandbox by default — set SSL_IS_LIVE=true only
# for the live store credentials, never with sandbox keys)
SSL_STORE_ID=
SSL_STORE_PASSWORD=
SSL_IS_LIVE=false

SERVER_URL=
MA_FRONTEND_URL=
EP_FRONTEND_URL=

EMAIL_USER=
EMAIL_PASS=

# Social Media Links
MA_FACEBOOK_GROUP_LINK=
MA_WHATSAPP_GROUP_LINK=
EP_FACEBOOK_GROUP_LINK=
EP_WHATSAPP_GROUP_LINK=

# Social Media Links for Emails
MA_EMAIL_SOCIAL_YOUTUBE=https://www.youtube.com/@misunacademy
MA_EMAIL_SOCIAL_FACEBOOK=https://www.facebook.com/misunacademy
MA_EMAIL_SOCIAL_LINKEDIN=https://www.linkedin.com/company/misun-academy
MA_EMAIL_SOCIAL_TWITTER=https://x.com/misunacademy
MA_EMAIL_SOCIAL_WEBSITE=http://localhost:3000

EP_EMAIL_SOCIAL_YOUTUBE=https://www.youtube.com/@EsunPoint
EP_EMAIL_SOCIAL_FACEBOOK=https://www.facebook.com/esunpoint
EP_EMAIL_SOCIAL_WEBSITE=http://localhost:3001

# Cloudinary Configuration (Required for image uploads)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

SSL_VALIDATION_API=https://sandbox.sslcommerz.com/validator/api/validationserverAPI.php

# Better Auth Configuration
BETTER_AUTH_SECRET=generate-with-openssl-rand-hex-32-min-32-chars
BETTER_AUTH_URL=http://localhost:5000/api/v1/auth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
AUTH_COOKIE_DOMAIN=
CLIENT_URL=

# Email Configuration (names must match src/config/env.ts)
EMAIL_FROM="Misun Academy" <no-reply@misun-academy.com>
EMAIL_PROVIDER=
EMAIL_HOST=
EMAIL_PORT=
EMAIL_SECURE=
EMAIL_MAX_RETRIES=3
LOG_LEVEL=info

# Admin Email for Employee Birthday Reminders (required)
ADMIN_EMAIL=

# Cron authentication (required in production for Vercel Cron)
CRON_SECRET=

# Upstash Redis (persistent rate limiting; falls back to in-memory when unset)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

GROQ_API_KEY=

# Sentry (optional error tracking)
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.1
