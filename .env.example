# ============================================================================
#  Misun Academy — API environment template
# ============================================================================
#  Copy to .env and fill in:            cp .env.example .env
#
#  Source of truth is src/config/env.ts (Zod schema). On boot the app
#  validates every variable and throws "Environment variables validation
#  failed" when a key marked [REQUIRED] is missing.
#
#  [REQUIRED]    no default in the schema -> app will not start without the key
#  [RECOMMENDED] has a default, but the related feature breaks or degrades
#  (optional)    safe to leave empty; defaults are shown in the comment
#
#  Note: an empty value ("KEY=") passes validation, so a half-filled .env
#  starts up and fails later at runtime. Fill every [REQUIRED] key.
# ============================================================================


# ----------------------------------------------------------------------------
# Runtime
# ----------------------------------------------------------------------------
# [REQUIRED] development | production | stage | test
# Use "production" on the deployed server, "development" locally.
NODE_ENV=production

# (optional) HTTP port. Default: 5000. Ignored on Vercel.
PORT=5000

# (optional) pino log level: fatal|error|warn|info|debug|trace|silent. Default: info
LOG_LEVEL=info


# ----------------------------------------------------------------------------
# Database
# ----------------------------------------------------------------------------
# [REQUIRED] MongoDB connection string (Atlas or self-hosted)
MONGO_URI=


# ----------------------------------------------------------------------------
# Super admin seed  (npm run seed:superAdmin)
# ----------------------------------------------------------------------------
# [REQUIRED] Credentials created/promoted by the seed script.
SUPER_ADMIN_EMAIL=
SUPER_ADMIN_PASSWORD=


# ----------------------------------------------------------------------------
# Better Auth  (session + credential auth)
# ----------------------------------------------------------------------------
# [REQUIRED] Signing secret for sessions/tokens. Generate once and keep it stable:
#   openssl rand -hex 32
# Changing this logs every user out.
BETTER_AUTH_SECRET=

# [REQUIRED] Public URL of this API *including* the auth base path.
# Example: https://api.example.com/api/v1/auth
BETTER_AUTH_URL=

# [RECOMMENDED] Cookie domain shared by the API and the frontends.
# Only used when NODE_ENV=production. Set the registrable parent
# domain (leading dot) so cookies work across subdomains, e.g. .example.com
# Leave empty for a single-host setup.
AUTH_COOKIE_DOMAIN=

# [RECOMMENDED] Extra trusted origin (e.g. a landing page or admin panel).
# Added to Better Auth trustedOrigins, socket.IO CORS and the CSRF allowlist.
CLIENT_URL=


# ----------------------------------------------------------------------------
# Google OAuth  (Better Auth social provider)
# ----------------------------------------------------------------------------
# [REQUIRED] Google Cloud Console -> Credentials -> OAuth client ID
# Authorized redirect URI must be: <BETTER_AUTH_URL>/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=


# ----------------------------------------------------------------------------
# Public URLs  (must be absolute, no trailing slash)
# ----------------------------------------------------------------------------
# [REQUIRED] This API's own public origin. Example: https://api.example.com
SERVER_URL=

# [REQUIRED] Misun Academy frontend. Example: https://example.com
MA_FRONTEND_URL=

# [REQUIRED] Esun Point frontend. Example: https://point.example.com
EP_FRONTEND_URL=


# ----------------------------------------------------------------------------
# SSLCommerz  (payment gateway)
# ----------------------------------------------------------------------------
# [REQUIRED] Store credentials. Sandbox and live stores use different IDs.
SSL_STORE_ID=
SSL_STORE_PASSWORD=

# [REQUIRED] "false" = sandbox, "true"/"1"/"yes" = live.
# Never pair live credentials with SSL_IS_LIVE=false (or vice versa):
# the validator host is derived from this flag.
SSL_IS_LIVE=false

# (optional) Validator endpoint override. Leave empty — it is derived from
# SSL_IS_LIVE (sandbox vs securepay) per the official docs.
SSL_VALIDATION_API=


# ----------------------------------------------------------------------------
# Payment maintenance job  (reconciliation / expiry / cleanup)
# ----------------------------------------------------------------------------
# All optional. Minutes/hours/days, integers as strings. Defaults below.

# How long an untouched gateway attempt waits before reconciliation.
PAYMENT_RECONCILE_AFTER_MINUTES=20

# How long an unpaid payment session stays open before it expires.
PAYMENT_SESSION_EXPIRY_MINUTES=30

# How long an unpaid enrollment may stay open before it is expired.
# Default: 48
ENROLLMENT_EXPIRY_HOURS=48

# How long a bootcamp purchase may stay pending.
BOOTCAMP_PURCHASE_EXPIRY_MINUTES=60

# Failed/cancelled records are hidden from learners immediately and
# hard-deleted once older than this window.
PAYMENT_ARTIFACT_RETENTION_DAYS=90


# ----------------------------------------------------------------------------
# Email delivery  (nodemailer + MongoDB-backed retry queue)
# ----------------------------------------------------------------------------
# [REQUIRED] SMTP login used for all outgoing mail. For Gmail use an App
# Password (Account -> Security -> 2-Step Verification -> App passwords).
EMAIL_USER=
EMAIL_PASS=

# Transport selection:
#   EMAIL_HOST empty  -> service: "gmail" (uses EMAIL_USER/EMAIL_PASS)
#   EMAIL_HOST set    -> explicit host/port/secure below
# (optional) e.g. smtp.example.com — leave empty to use Gmail
EMAIL_HOST=
# (optional) Default: 587
EMAIL_PORT=
# (optional) "true" for port 465 (implicit TLS), "false" for 587/STARTTLS
EMAIL_SECURE=

# (optional) From header. Default: "Misun Academy" <no-reply@misun-academy.com>
# Must match a domain you are allowed to send from (SPF/DKIM/DMARC).
EMAIL_FROM="Misun Academy" <no-reply@misun-academy.com>

# (optional) Queue retry attempts per email. Default: 3
EMAIL_MAX_RETRIES=3


# ----------------------------------------------------------------------------
# Email branding — Misun Academy (MA) templates
# ----------------------------------------------------------------------------
# Links rendered in the MA email footer. Set these to real public URLs;
# leaving them empty (or on localhost) ships broken links to users.

# Social group invite links — also the fallback for the public Settings API.
MA_FACEBOOK_GROUP_LINK=
MA_WHATSAPP_GROUP_LINK=

MA_EMAIL_SOCIAL_YOUTUBE=https://www.youtube.com/@misunacademy
MA_EMAIL_SOCIAL_FACEBOOK=https://www.facebook.com/misunacademy
MA_EMAIL_SOCIAL_LINKEDIN=https://www.linkedin.com/company/misun-academy


# ----------------------------------------------------------------------------
# Email branding — Esun Point (EP) templates
# ----------------------------------------------------------------------------
EP_FACEBOOK_GROUP_LINK=
EP_WHATSAPP_GROUP_LINK=

EP_EMAIL_SOCIAL_YOUTUBE=https://www.youtube.com/@EsunPoint
EP_EMAIL_SOCIAL_FACEBOOK=https://www.facebook.com/esunpoint


# ----------------------------------------------------------------------------
# Cloudinary  (image uploads: thumbnails, avatars, certificates)
# ----------------------------------------------------------------------------
# [REQUIRED] Uploads fail with a 500 if these are missing.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=


# ----------------------------------------------------------------------------
# Internal notifications
# ----------------------------------------------------------------------------
# [REQUIRED] Recipient of the daily employee-birthday reminder digest.
ADMIN_EMAIL=


# ----------------------------------------------------------------------------
# Cron authentication
# ----------------------------------------------------------------------------
# [RECOMMENDED] Vercel Cron (and any external scheduler) calls the batch
# auto-transition and payment-maintenance endpoints with
#   Authorization: Bearer <CRON_SECRET>
# If unset, the secret path is closed and those calls return 401.
CRON_SECRET=


# ----------------------------------------------------------------------------
# API docs  (Scalar reference at /docs + /openapi.json)
# ----------------------------------------------------------------------------
# (optional) Docs are served in every non-production environment. In production
# they stay disabled unless this is exactly "true".
ENABLE_API_DOCS=


# ----------------------------------------------------------------------------
# AI chatbot  (Groq)
# ----------------------------------------------------------------------------
# (optional) Chat endpoints return 500 without it.
GROQ_API_KEY=


# ----------------------------------------------------------------------------
# Sentry  (error tracking / tracing)
# ----------------------------------------------------------------------------
# (optional) Empty = Sentry disabled.
SENTRY_DSN=
# (optional) Trace sample rate 0.0–1.0. Default: 0.1
SENTRY_TRACES_SAMPLE_RATE=0.1
